import colorsys

name = input("Name: ")

rgb = input("Raw RGB: ")
if rgb != "":
    rgb = rgb.replace(",", "").replace("  "," ")
    rgb = rgb.split(" ")
    for x in range(len(rgb)):
        rgb[x] = float(rgb[x])

    color = colorsys.rgb_to_hsv(rgb[0], rgb[1], rgb[2])
    color = colorsys.hsv_to_rgb(color[0], color[1]/0.6, color[2]/0.8)

    c = []
    for x in color:
        c.append(str(round(x)))
    color = " ".join(c)
    


with open(name+".nation", "w") as file:
    template = f"""namespace = NAMESPACE
tag = TAG

loc = {{
    $ = "{name}"
    $_DEF = "The "
    $_ADJ = ""

    $_democratic = "{name}"
    $_DEF_democratic = "The "

    $_communism = "{name}"
    $_DEF_communism = "The "

    $_fascism = "{name}"
    $_DEF_fascism = "The "

    $_neutrality = "{name}"
    $_DEF_neutrality = "The "
}}

color = {{ {color} }}

cores = {{  }}

history = {{
    capital = CAPITAL
    
    set_research_slots = 2
    set_stability = 0.5
    set_war_support = 0.5
    set_convoys = 10

    set_politics = {{
        ruling_party = democratic/communism/fascism/neutrality
        last_election = "1936.1.1"
        election_frequency = 48
        elections_allowed = no
    }}

    set_popularities = {{
        democratic = 25
        neutrality = 25
        fascism = 25
        communism = 25
    }}

    setup_starting_tech = yes
}}"""
    file.write(template)